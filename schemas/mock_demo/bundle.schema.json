{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/nufield/mock-demo-bundle.schema.json",
  "title": "NUFIELD Synthetic Demo Bundle",
  "description": "Schema for synthetic UI fixtures only. This schema does not validate cosmological or scientific validity.",
  "type": "object",
  "required": [
    "schema_version",
    "bundle_kind",
    "generator_version",
    "generated_at",
    "run_id",
    "options",
    "scenario",
    "provenance",
    "dataset",
    "manifest",
    "benchmark_report",
    "parameter_samples",
    "posterior_chains",
    "power_spectrum",
    "expansion_history",
    "survey_catalog",
    "cmb_summary",
    "lensing_catalog",
    "validation_report",
    "experiment_history",
    "ablation_report",
    "data_quality_report",
    "field_summary",
    "summary"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "bundle_kind": { "type": "string", "const": "nufield-synthetic-demo-bundle" },
    "generator_version": { "type": "string" },
    "generated_at": { "type": "string", "format": "date-time" },
    "run_id": { "type": "string", "minLength": 1 },
    "options": {
      "type": "object",
      "required": ["scenario", "seed", "sample_count", "observation_count", "chain_count", "samples_per_chain", "spectrum_points", "history_count", "field_slices"],
      "properties": {
        "scenario": { "type": "string" },
        "seed": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "sample_count": { "type": "integer", "minimum": 20, "maximum": 100000 },
        "observation_count": { "type": "integer", "minimum": 20, "maximum": 100000 },
        "chain_count": { "type": "integer", "minimum": 1, "maximum": 8 },
        "samples_per_chain": { "type": "integer", "minimum": 50, "maximum": 10000 },
        "spectrum_points": { "type": "integer", "minimum": 30, "maximum": 2000 },
        "history_count": { "type": "integer", "minimum": 8, "maximum": 5000 },
        "field_slices": { "type": "integer", "minimum": 20, "maximum": 2000 }
      },
      "additionalProperties": false
    },
    "scenario": {
      "type": "object",
      "required": ["scenario_id", "label", "group", "description", "is_synthetic_profile", "scientific_warning"],
      "properties": {
        "scenario_id": { "type": "string" },
        "label": { "type": "string" },
        "group": { "type": "string" },
        "description": { "type": "string" },
        "is_synthetic_profile": { "type": "boolean", "const": true },
        "scientific_warning": { "type": "string", "minLength": 20 }
      },
      "additionalProperties": true
    },
    "provenance": {
      "type": "object",
      "required": ["source_kind", "generated_from_real_observations", "generated_from_cosmology_solver", "posterior_is_scientific", "calibrated", "physical_units_verified", "warning"],
      "properties": {
        "source_kind": { "type": "string", "const": "synthetic-demo-generator" },
        "generated_from_real_observations": { "type": "boolean", "const": false },
        "generated_from_cosmology_solver": { "type": "boolean", "const": false },
        "posterior_is_scientific": { "type": "boolean", "const": false },
        "calibrated": { "type": "boolean", "const": false },
        "physical_units_verified": { "type": "boolean", "const": false },
        "warning": { "type": "string", "minLength": 20 }
      },
      "additionalProperties": true
    },
    "dataset": {
      "type": "object",
      "required": ["schema_version", "dataset_name", "dataset_id", "physics_level", "is_synthetic", "feature_names", "parameter_names", "scientific_warning"],
      "properties": {
        "schema_version": { "type": "string" },
        "dataset_name": { "type": "string" },
        "dataset_id": { "type": "string" },
        "physics_level": { "type": "string", "const": "toy" },
        "is_synthetic": { "type": "boolean", "const": true },
        "feature_names": { "type": "array", "items": { "type": "string" } },
        "parameter_names": { "type": "array", "items": { "type": "string" } },
        "scientific_warning": { "type": "string", "minLength": 20 }
      },
      "additionalProperties": true
    },
    "manifest": { "type": "object", "required": ["is_synthetic", "source_kind", "scientific_warning"], "properties": { "is_synthetic": { "const": true }, "source_kind": { "type": "string", "const": "synthetic-demo-generator" }, "scientific_warning": { "type": "string" } }, "additionalProperties": true },
    "benchmark_report": { "type": "object", "required": ["is_synthetic", "parameter_names", "median_absolute_error", "coverage_diagnostic", "split_disjoint", "scientific_warning"], "properties": { "is_synthetic": { "const": true }, "parameter_names": { "type": "array", "items": { "type": "string" } }, "median_absolute_error": { "type": "object" }, "coverage_diagnostic": { "type": "array" }, "split_disjoint": { "type": "boolean" }, "scientific_warning": { "type": "string" } }, "additionalProperties": true },
    "parameter_samples": { "type": "object", "required": ["is_synthetic", "rows", "parameter_names", "scientific_warning"], "properties": { "is_synthetic": { "const": true }, "rows": { "type": "array", "items": { "type": "object", "required": ["id", "realization_id", "split", "is_synthetic"], "properties": { "id": { "type": "string" }, "realization_id": { "type": "string" }, "split": { "enum": ["train", "validation", "test"] }, "is_synthetic": { "const": true } }, "additionalProperties": true } }, "parameter_names": { "type": "array", "items": { "type": "string" } }, "scientific_warning": { "type": "string" } }, "additionalProperties": true },
    "posterior_chains": { "type": "object", "required": ["is_synthetic", "chains", "warning"], "properties": { "is_synthetic": { "const": true }, "chains": { "type": "array" }, "warning": { "type": "string" } }, "additionalProperties": true },
    "power_spectrum": { "type": "object", "required": ["is_synthetic", "points", "scientific_warning"], "properties": { "is_synthetic": { "const": true }, "points": { "type": "array" }, "scientific_warning": { "type": "string" } }, "additionalProperties": true },
    "expansion_history": { "type": "object", "required": ["is_synthetic", "points", "scientific_warning"], "properties": { "is_synthetic": { "const": true }, "points": { "type": "array" }, "scientific_warning": { "type": "string" } }, "additionalProperties": true },
    "survey_catalog": { "type": "object", "required": ["is_synthetic", "rows", "scientific_warning"], "properties": { "is_synthetic": { "const": true }, "rows": { "type": "array" }, "scientific_warning": { "type": "string" } }, "additionalProperties": true },
    "cmb_summary": { "type": "object", "required": ["is_synthetic", "points", "scientific_warning"], "properties": { "is_synthetic": { "const": true }, "points": { "type": "array" }, "scientific_warning": { "type": "string" } }, "additionalProperties": true },
    "lensing_catalog": { "type": "object", "required": ["is_synthetic", "rows", "scientific_warning"], "properties": { "is_synthetic": { "const": true }, "rows": { "type": "array" }, "scientific_warning": { "type": "string" } }, "additionalProperties": true },
    "validation_report": { "type": "object", "required": ["is_synthetic", "overall_status", "checks", "scientific_warning"], "properties": { "is_synthetic": { "const": true }, "overall_status": { "enum": ["PASS", "WARN", "FAIL"] }, "checks": { "type": "array" }, "scientific_warning": { "type": "string" } }, "additionalProperties": true },
    "experiment_history": { "type": "object", "required": ["is_synthetic", "runs", "scientific_warning"], "properties": { "is_synthetic": { "const": true }, "runs": { "type": "array" }, "scientific_warning": { "type": "string" } }, "additionalProperties": true },
    "ablation_report": { "type": "object", "required": ["is_synthetic", "results", "scientific_warning"], "properties": { "is_synthetic": { "const": true }, "results": { "type": "array" }, "scientific_warning": { "type": "string" } }, "additionalProperties": true },
    "data_quality_report": { "type": "object", "required": ["is_synthetic", "metrics", "scientific_warning"], "properties": { "is_synthetic": { "const": true }, "metrics": { "type": "array" }, "scientific_warning": { "type": "string" } }, "additionalProperties": true },
    "field_summary": { "type": "object", "required": ["is_synthetic", "slices", "scientific_warning"], "properties": { "is_synthetic": { "const": true }, "slices": { "type": "array" }, "scientific_warning": { "type": "string" } }, "additionalProperties": true },
    "summary": { "type": "object", "required": ["scenario", "seed", "parameter_rows", "survey_rows", "artifact_count", "all_synthetic", "scientific_warning"], "properties": { "all_synthetic": { "const": true }, "scientific_warning": { "type": "string" } }, "additionalProperties": true }
  },
  "additionalProperties": true
}
